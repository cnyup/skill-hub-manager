{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "skill-hub desktop default capability: shell access limited to the skill-hub wrapper",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "skill-hub",
          "command": "../bin/skill-hub",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "skill-hub",
          "command": "../bin/skill-hub",
          "args": true
        }
      ]
    },
    "shell:allow-stdin-write"
  ]
}
