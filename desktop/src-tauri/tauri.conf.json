{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "skill-hub",
  "version": "0.1.0",
  "identifier": "dev.skill-hub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "skill-hub",
        "width": 1180,
        "height": 720,
        "minWidth": 940,
        "minHeight": 600,
        "hiddenTitle": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": {
      "../../bin/skill-hub": "bin/skill-hub",
      "../../src": "src"
    },
    "icon": ["icons/icon.png", "icons/icon-32.png", "icons/icon-128.png", "icons/icon-128@2x.png"]
  }
}
